# Names of the environment variables the hosted API needs. Put real values in
# Vercel's project settings (or a local, git-ignored .env for `vercel dev`).
# Never commit values, and never expose any of these in a public-prefixed
# variable (NEXT_PUBLIC_*, VITE_*, ...).

# Supabase project. The service-role key bypasses row level security: only the API holds it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random bytes each, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
POW_SECRET=
IP_SALT_SECRET=

# Cloudflare Turnstile secret key (hosted site only)
TURNSTILE_SECRET=

# Proof-of-work difficulty in leading zero bits (default 18, about 1-2 s on a laptop)
POW_DIFFICULTY=

# Exact origin of the hosted site, for CORS (for example https://example.org)
SITE_ORIGIN=

# Secret for the cron endpoints (Vercel sends it as a bearer token)
CRON_SECRET=
